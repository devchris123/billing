          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.project_id AS project, s.instance_id, s.started_at, s.stopped_at, ROUND((EXTRACT(EPOCH FROM (s.stopped_at - s.started_at)) / 60.0)::numeric, 1) AS duration_minutes, e.flavour AS flavor, s.start_event_id, s.stop_event_id FROM sessions s JOIN vm_events e ON e.event_id = s.start_event_id ORDER BY s.stopped_at DESC LIMIT 100;",
